---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { FORMS, SITE, SOCIAL } from '../config';
---
<Base title="Contact Titus Corlatean" description="Scrie-mi un mesaj. Contact Titus Corlățean, senator al României.">
  <section class="contact dark">
    <div class="contact__photo" aria-hidden="true">
      <img src="/images/foto-camasa.webp" alt="" fetchpriority="high" width="934" height="1400" />
    </div>
    <div class="wrap contact__grid">
      <div class="contact__form-wrap">
        <h1 class="contact__title rule">Scrie-mi un mesaj</h1>

        <form class="contact__form" data-form="contact" data-endpoint={FORMS.contact} novalidate
          data-success="Mulțumesc pentru mesaj. Îți voi răspunde cât mai curând.">
          <input type="hidden" name="_subject" value="Mesaj nou de pe titus-corlatean.ro" />
          <input type="text" name="_gotcha" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <div class="contact__row">
            <div class="field">
              <label for="c-fname">Prenume <span class="req">*</span></label>
              <input id="c-fname" name="prenume" type="text" autocomplete="given-name" required />
            </div>
            <div class="field">
              <label for="c-lname">Nume <span class="req">*</span></label>
              <input id="c-lname" name="nume" type="text" autocomplete="family-name" required />
            </div>
          </div>
          <div class="field">
            <label for="c-email">E-Mail <span class="req">*</span></label>
            <input id="c-email" name="email" type="email" autocomplete="email" required />
          </div>
          <label class="check">
            <input type="checkbox" name="abonare_newsletter" value="da" />
            <span>Vreau să primesc noutăți și actualizări</span>
          </label>
          <div class="field">
            <label for="c-msg">Mesajul tău: <span class="req">*</span></label>
            <textarea id="c-msg" name="mesaj" required></textarea>
          </div>
          <p class="contact__legal">Datele trimise sunt folosite doar pentru a-ți răspunde. Detalii în <a href="/politica-de-confidenialitate">Politica de confidențialitate</a>.</p>
          <div>
            <button type="submit" class="btn">Trimite <Icon name="arrow" /></button>
          </div>
          <p class="form-status" role="status" aria-live="polite"></p>
        </form>
      </div>

      <aside class="contact__aside">
        <a class="contact__line" href={`mailto:${SITE.email}`}>
          <Icon name="mail" /> <span>{SITE.email}</span>
        </a>
        <a class="contact__line" href={SOCIAL.facebook} target="_blank" rel="noopener">
          <Icon name="facebook" /> <span>titus.corlatean.official</span>
        </a>
        <a class="contact__line" href={SOCIAL.tiktok} target="_blank" rel="noopener">
          <Icon name="tiktok" /> <span>@tituscorlatean</span>
        </a>
      </aside>
    </div>
  </section>
</Base>

<style>
  .contact { position: relative; overflow: hidden; isolation: isolate; }
  .contact__photo { position: absolute; top: 0; right: 0; bottom: 0; width: 42%; z-index: -1; }
  .contact__photo img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 15%; }
  .contact__photo::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, #000 0%, rgba(0, 0, 0, 0.35) 45%, rgba(0, 0, 0, 0.15)); }
  .contact__grid { display: grid; grid-template-columns: minmax(0, 640px); gap: 2.4rem; padding-block: clamp(3.5rem, 8vw, 6.5rem) clamp(4rem, 9vw, 7rem); }
  .contact__title { font-size: clamp(2.3rem, 1.4rem + 3.4vw, 4rem); margin-bottom: 2.4rem; }
  .contact__form { display: grid; gap: 1.2rem; }
  .contact__row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; }
  .contact__legal { font-size: 0.85rem; color: var(--on-dark-soft); margin: 0; }
  .contact__legal a { color: var(--on-dark); }
  .contact__aside { display: flex; flex-wrap: wrap; gap: 0.7rem; padding-top: 2.2rem; border-top: 1px solid var(--line-dark); }
  .contact__line {
    display: inline-flex; align-items: center; gap: 0.8rem; padding: 0.85rem 1.1rem;
    border: 1px solid rgba(255, 255, 255, 0.28); border-radius: var(--r-sm);
    text-decoration: none; font-weight: 700; transition: background-color 0.25s, border-color 0.25s;
  }
  .contact__line:hover { background: var(--red); border-color: var(--red); }
  .contact__line :global(svg) { width: 20px; height: 20px; flex: none; }
  @media (max-width: 900px) {
    .contact__photo { position: relative; width: 100%; height: 230px; }
    .contact__title { margin-bottom: 1.6rem; }
    .contact__photo::after { background: linear-gradient(0deg, #000 0%, rgba(0, 0, 0, 0) 60%); }
    .contact__grid { grid-template-columns: 1fr; padding-top: 1rem; }
    .contact__aside { flex-direction: column; align-items: flex-start; padding-top: 1.8rem; }
  }
  @media (max-width: 520px) { .contact__row { grid-template-columns: 1fr; } }
</style>
