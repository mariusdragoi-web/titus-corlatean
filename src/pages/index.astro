---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { SITE } from '../config';
import { personLd } from '../lib/person';

const themes = [
  {
    title: 'Aderarea României la OCDE',
    text: 'Aderarea la Organizația pentru Cooperare şi Dezvoltare Economică (OCDE), nu este doar un obiectiv diplomatic — este o șansă reală de reformă, dezvoltare și consolidare instituțională. În calitate de vicepreședinte al comisiei parlamentare pentru sprijinirea aderării României la OCDE și reprezentant al Consiliului Europei în relația cu OCDE, susțin prin toate mijloacele posibile aderarea României la această organizație.',
  },
  {
    title: 'Județul Dâmbovița',
    text: 'De zece ani sprijin dezvoltarea județului Dâmbovița, în atragerea de fonduri europene, în modernizarea infrastructurii publice, în educație și în sistemul medical. De la investiții în comunitățile rurale la proiecte strategice pentru orașe, am lucrat împreună cu autoritățile locale pentru ca proiectele să ajungă de pe hârtie pe teren. Biroul parlamentar din județ rămâne deschis pentru audiențe.',
  },
  {
    title: 'Reîntregirea familiilor românești',
    text: 'În calitate de senator și președinte al Comisiei pentru politică externă a Senatului, m-am implicat activ în apărarea drepturilor familiilor române din diaspora, în special în situațiile în care copiii au fost separați de părinți de către autoritățile din statele de reședință. Am condus misiuni oficiale și am participat la demersuri diplomatice complexe pentru a susține reîntregirea acestor familii și repatrierea copiilor, acolo unde a fost posibil. În cadrul acestor acțiuni, am semnalat încălcări ale tratatelor internaționale și am cerut respectarea drepturilor fundamentale ale cetățenilor români, în spiritul valorilor europene și al demnității umane. Am fost prezent și în spațiul public, alături de societatea civilă, pentru a susține cauzele părinților români și pentru a transmite un mesaj clar: familia trebuie protejată, iar interesele copilului trebuie apărate cu responsabilitate și echilibru.',
  },
];

// Date structurate pentru Google: cine e Titus Corlățean și unde mai apare oficial
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      url: SITE.url,
      name: SITE.name,
      inLanguage: 'ro-RO',
      publisher: { '@id': `${SITE.url}/#person` },
    },
    personLd(),
  ],
};

---
<Base title="Titus Corlățean — Senator al României, jurist și diplomat" rawTitle htmlClass="snap"
  description="Titus Corlățean, om politic român, senator PSD și fost ministru, apără valorile naționale și drepturile românilor.">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- Hero -->
  <section class="hero dark snap" id="acasa">
    <div class="hero__photo" aria-hidden="true">
      <img src="/images/foto-zambet.webp" alt="" fetchpriority="high" width="2000" height="1334" />
    </div>
    <div class="hero__inner wrap">
      <div class="hero__text">
        <h1 class="hero__title display">
          <span class="hero__line">În <em class="red">slujba</em></span>
          <span class="hero__line">României,</span>
        </h1>
        <p class="hero__sub quote-style">în Europa și în lume.</p>
        <div class="hero__cta">
          <a href="/povestea-mea" class="btn">Povestea mea <Icon name="arrow" /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- Priorități -->
  <section class="themes section snap" id="prioritati">
    <div class="wrap themes__grid">
      <header class="themes__head reveal">
        <h2 class="h2 rule">Priorități</h2>
      </header>
      <ol class="themes__list">
        {themes.map((t, i) => (
          <li class:list={['theme acc-item reveal', { 'is-open': i === 0 }]}>
            <span class="theme__n">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="theme__title"><button type="button" class="acc-btn">{t.title}<span class="acc-icon" aria-hidden="true"></span></button></h3>
            <p class="theme__text acc-body">{t.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <NewsletterSignup />
</Base>

<style>
  /* Hero */
  .hero { position: relative; overflow: hidden; isolation: isolate; min-height: calc(100dvh - 92px); display: flex; flex-direction: column; justify-content: center; }
  .hero__photo { position: absolute; inset: 0 0 0 22%; z-index: -1; }
  .hero__photo img {
    width: 100%; height: 100%; object-fit: cover; object-position: 72% 18%; animation: hero-zoom 14s var(--ease) both;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 34%); mask-image: linear-gradient(90deg, transparent 0%, #000 34%);
  }
  .hero__photo::after {
    content: ''; position: absolute; inset: 0;
    background:
      linear-gradient(90deg, #000 0%, rgba(0, 0, 0, 0.6) 22%, rgba(0, 0, 0, 0) 50%),
      linear-gradient(180deg, #000 0%, rgba(0, 0, 0, 0) 14%),
      linear-gradient(0deg, rgba(0, 0, 0, 0.95) 0%, rgba(0, 0, 0, 0) 32%);
  }
  @keyframes hero-zoom { from { transform: scale(1.08); } to { transform: scale(1); } }
  .hero__inner { padding-block: clamp(4rem, 10vh, 7rem) 2rem; flex: 1; display: flex; align-items: center; }
  .hero__text { max-width: 640px; }
  .hero__title { margin: 0 0 0.25em; font-size: clamp(3rem, 1.6rem + 6vw, 7rem); }
  .hero__line { display: block; animation: rise 1.1s var(--ease) both; }
  .hero__line:nth-child(2) { animation-delay: 0.12s; }
  .hero__title em { font-style: normal; }
  .hero__sub { font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.4rem); color: var(--on-dark); opacity: 0.85; margin-bottom: 2.4rem; animation: rise 1.1s 0.25s var(--ease) both; }
  .hero__cta { animation: rise 1.1s 0.38s var(--ease) both; }
  @keyframes rise { from { opacity: 0; transform: translateY(26px); } to { opacity: 1; transform: none; } }



  /* Priorități */
  .themes__grid { display: grid; grid-template-columns: minmax(0, 0.5fr) 1.5fr; gap: clamp(2.5rem, 6vw, 6rem); align-items: start; }
  .themes__head { position: sticky; top: calc(var(--header-h) + 2rem); }
  .themes__head .h2 { max-width: 12ch; }
  .themes__list { list-style: none; margin: 0; padding: 0; }
  .theme {
    display: grid; grid-template-columns: 3.5rem 1fr; gap: 0.8rem 1rem; align-items: baseline;
    padding: clamp(1.8rem, 3.5vw, 2.6rem) 0; border-top: 1px solid var(--line);
  }
  .theme:last-child { border-bottom: 1px solid var(--line); }
  .theme__n { font-family: var(--display); font-weight: 800; font-size: 1.1rem; color: var(--red); }
  .theme__title { font-family: var(--display); font-weight: 800; font-size: clamp(1.5rem, 1.2rem + 1vw, 2.1rem); margin: 0; letter-spacing: -0.02em; line-height: 1.12; }
  .theme__text { grid-column: 2; margin: 0; color: var(--text-soft); font-size: 1.04rem; }

  @media (min-width: 761px) and (max-width: 1080px) {
    .hero__photo { inset: 0 0 0 34%; }
    .hero__photo img { object-position: 60% 15%; }
    .hero__photo::after { background: linear-gradient(90deg, #000 0%, rgba(0, 0, 0, 0.5) 20%, rgba(0, 0, 0, 0) 45%), linear-gradient(0deg, rgba(0, 0, 0, 0.95) 0%, rgba(0, 0, 0, 0) 32%); }
    .hero__text { max-width: 48%; }
    .hero__title { font-size: clamp(2.8rem, 6.4vw, 4.4rem); }
  }
  @media (max-width: 960px) {
    .themes__grid { grid-template-columns: 1fr; }
    .themes__head { position: static; }
  }
  @media (max-width: 760px) {
    .hero { min-height: 0; display: block; }
    /* Pe telefon: poza (cap și umeri) sus, titlul dedesubt pe negru curat — fără text peste cămașă/cravată */
    .hero__photo { position: relative; inset: auto; height: auto; aspect-ratio: 6 / 5; max-height: 380px; overflow: hidden; }
    .hero__photo img { object-position: 64% 4%; -webkit-mask-image: none; mask-image: none; }
    .hero__photo::after { background: linear-gradient(0deg, #000 0%, rgba(0, 0, 0, 0.55) 16%, rgba(0, 0, 0, 0) 40%); }
    .hero__inner { margin-top: 0.4rem; padding: 0 0 1.5rem; position: relative; }
    .hero__title { font-size: clamp(2.7rem, 12vw, 3.6rem); }
    .hero__sub { font-size: 1.35rem; margin-bottom: 1.8rem; }
    .themes__grid { grid-template-columns: 1fr; gap: 1.6rem; }
    .themes__head { position: static; }
    .themes__list { display: grid; gap: 0.7rem; }
    .theme, .theme:last-child {
      grid-template-columns: 2.1rem 1fr; gap: 0 0.5rem; align-items: center;
      padding: 1rem 1rem 1rem 1.1rem; border: 0; border-left: 4px solid var(--red);
      background: var(--paper-2); border-radius: 0 var(--r-md) var(--r-md) 0;
    }
    .theme.is-open { background: #fff; box-shadow: var(--shadow); }
    .theme__n { font-size: 0.9rem; }
    .theme__title { font-size: 1.18rem; letter-spacing: -0.015em; }
    .theme__text { grid-column: 1 / -1; font-size: 0.98rem; margin-top: 0.8rem; color: var(--text); }
    .themes.section { padding-block: 2.6rem 3rem; }
  }
</style>
