---
import Icon from './Icon.astro';
import { NAV } from '../config';

const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
---
<header class="site-header" data-header>
  <div class="site-header__inner wrap">
    <a href="/" class="brand" aria-label="Titus Corlățean — pagina principală">
      <img src="/images/logo-alb.webp" alt="Titus Corlățean" width="1000" height="394" />
    </a>

    <nav class="nav" aria-label="Navigare principală">
      <ul class="nav__list">
        {NAV.map((item) =>
          item.children ? (
            <li class="nav__item nav__item--drop">
              <button class:list={['nav__link', { 'is-active': item.children.some((c) => isActive(c.href)) }]} aria-expanded="false" aria-haspopup="true" data-drop>
                {item.label}
                <Icon name="chevron" class="nav__chev" />
              </button>
              <div class="drop">
                <ul>
                  {item.children.map((c) => (
                    <li>
                      <a href={c.href} class:list={{ 'is-active': isActive(c.href) }} aria-current={isActive(c.href) ? 'page' : undefined}>{c.label}</a>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ) : (
            <li class="nav__item">
              <a href={item.href} class:list={['nav__link', { 'is-active': isActive(item.href!) }]} aria-current={isActive(item.href!) ? 'page' : undefined}>{item.label}</a>
            </li>
          )
        )}
      </ul>
    </nav>

    <button class="menu-btn" aria-expanded="false" aria-controls="mobile-menu" data-menu-open>
      <span class="visually-hidden">Deschide meniul</span>
      <Icon name="menu" />
    </button>
  </div>

</header>

<div class="mobile-menu" id="mobile-menu" hidden data-menu>
  <div class="mobile-menu__top wrap">
    <a href="/" class="brand"><img src="/images/logo-alb.webp" alt="Titus Corlățean" width="1000" height="394" /></a>
    <button class="menu-btn" data-menu-close><span class="visually-hidden">Închide meniul</span><Icon name="close" /></button>
  </div>
  <nav class="mobile-menu__nav wrap" aria-label="Navigare mobilă">
    <ul>
      {NAV.map((item) =>
        item.children ? (
          <li class="mm-group">
            <span class="mm-label">{item.label}</span>
            <ul>
              {item.children.map((c) => (
                <li><a href={c.href} class:list={{ 'is-active': isActive(c.href) }}>{c.label}</a></li>
              ))}
            </ul>
          </li>
        ) : (
          <li><a href={item.href} class:list={['mm-main', { 'is-active': isActive(item.href!) }]}>{item.label}</a></li>
        )
      )}
    </ul>
  </nav>
</div>

<style>
  .site-header {
    position: sticky; top: 0; z-index: var(--z-header);
    background: var(--ink);
    color: var(--on-dark);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s, background-color 0.3s;
  }
  :global(.site-header.is-scrolled) { border-bottom-color: var(--line-dark); }
  .site-header__inner { display: flex; align-items: center; justify-content: space-between; gap: 2rem; height: 92px; }
  .brand img { width: 150px; height: auto; }
  .nav { display: flex; align-items: center; gap: 2rem; }
  .nav__list { display: flex; gap: 0.3rem; list-style: none; margin: 0; padding: 0; }
  .nav__item { position: relative; }
  .nav__link {
    display: inline-flex; align-items: center; gap: 0.3rem;
    padding: 0.6rem 0.85rem; border-radius: var(--r-sm);
    background: none; border: 0; cursor: pointer;
    font-size: 0.93rem; font-weight: 700; text-decoration: none; color: var(--on-dark-soft);
    transition: color 0.2s, background-color 0.2s;
  }
  .nav__link:hover, .nav__link.is-active, .nav__link[aria-expanded='true'] { color: #fff; }
  .nav__link.is-active { background: rgba(255, 255, 255, 0.07); }
  .nav__chev { width: 15px; height: 15px; transition: transform 0.25s var(--ease); }
  .nav__link[aria-expanded='true'] .nav__chev { transform: rotate(180deg); }

  .drop {
    position: absolute; top: calc(100% + 10px); left: 50%;
    width: 330px; padding: 0.6rem;
    background: var(--paper); color: var(--text);
    border-radius: var(--r-md); box-shadow: 0 24px 60px -20px rgba(0, 0, 0, 0.55);
    opacity: 0; visibility: hidden; transform: translate(-50%, -6px);
    transition: opacity 0.22s var(--ease), transform 0.22s var(--ease), visibility 0.22s;
  }
  .drop::before { content: ''; position: absolute; inset: -12px 0 auto; height: 12px; }
  .nav__item--drop:hover .drop,
  .nav__item--drop:focus-within .drop,
  :global(.nav__link[aria-expanded='true']) + .drop { opacity: 1; visibility: visible; transform: translate(-50%, 0); }
  .drop ul { list-style: none; margin: 0; padding: 0; }
  .drop a {
    display: block; padding: 0.75rem 0.9rem; border-radius: 6px;
    text-decoration: none; font-size: 0.95rem; font-weight: 700; line-height: 1.35;
    transition: background-color 0.2s, color 0.2s;
  }
  .drop a:hover { background: var(--paper-2); color: var(--red); }
  .drop a.is-active { color: var(--red); }


  .menu-btn { display: none; width: 46px; height: 46px; place-items: center; border: 1px solid var(--line-dark); border-radius: 50%; background: none; color: var(--on-dark); cursor: pointer; }
  .menu-btn :global(svg) { width: 22px; height: 22px; }

  .mobile-menu {
    position: fixed; inset: 0; z-index: var(--z-menu);
    background: var(--ink); color: var(--on-dark);
    overflow-y: auto; padding-bottom: 3rem;
  }
  .mobile-menu__top { display: flex; align-items: center; justify-content: space-between; height: 84px; }
  .mobile-menu__nav ul { list-style: none; margin: 0; padding: 0; }
  .mobile-menu__nav > ul > li { border-bottom: 1px solid var(--line-dark); }
  .mm-main { display: block; padding: 1rem 0; font-family: var(--display); font-weight: 700; font-size: 1.6rem; letter-spacing: -0.02em; text-decoration: none; }
  .mm-label { display: block; padding: 1.4rem 0 0.4rem; font-size: 0.75rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--on-dark); font-weight: 700; }
  .mm-group ul { padding-bottom: 1rem !important; }
  .mm-group a { display: block; padding: 0.55rem 0; font-size: 1.1rem; text-decoration: none; color: var(--on-dark-soft); }
  .mobile-menu a.is-active { color: #fff; }

  @media (max-width: 1080px) {
    .nav { display: none; }
    .menu-btn { display: grid; }
    .site-header__inner { height: 68px; }
    .brand img { width: 118px; }
    .mobile-menu__top { height: 68px; }
    .menu-btn { width: 42px; height: 42px; }
  }
</style>
