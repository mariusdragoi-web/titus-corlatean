---
import Icon from './Icon.astro';
import { FORMS, TURNSTILE_SITEKEY } from '../config';
---
<section class="nl snap" id="mesaj">
  <div class="wrap nl__grid reveal">
    <div class="nl__intro">
      <h2 class="nl__title"><span class="nowrap">Trimite-mi</span> un mesaj</h2>
      <p class="nl__lead">Ai o întrebare, o propunere sau o problemă? <span class="nowrap">Scrie-mi</span> direct.</p>
    </div>

    <form class="nl__form" data-form="contact" data-endpoint={FORMS.contact} novalidate
      data-success="Mulțumesc pentru mesaj. Îți voi răspunde cât mai curând.">
      <input type="text" name="hp" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <div class="nl__row">
        <div class="nl__field">
          <label for="m-fname">Prenume</label>
          <input id="m-fname" name="prenume" type="text" autocomplete="given-name" required />
        </div>
        <div class="nl__field">
          <label for="m-lname">Nume</label>
          <input id="m-lname" name="nume" type="text" autocomplete="family-name" required />
        </div>
        <div class="nl__field nl__field--email">
          <label for="m-email">E-mail</label>
          <input id="m-email" name="email" type="email" autocomplete="email" inputmode="email" required />
        </div>
      </div>

      <div class="nl__field">
        <label for="m-msg">Mesajul tău</label>
        <textarea id="m-msg" name="mesaj" rows="3" required></textarea>
      </div>

      <div class="ts-box" data-turnstile={TURNSTILE_SITEKEY} data-theme="light"></div>

      <div class="nl__actions">
        <button type="submit" class="nl__submit">Trimite <Icon name="arrow" /></button>
        <p class="nl__note">Datele trimise sunt folosite doar pentru a-ți răspunde. Detalii în <a href="/politica-de-confidenialitate">Politica de confidențialitate</a>.</p>
      </div>

      <p class="form-status" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<style>
  .nl { background: var(--red); color: #fff; }
  /* Pe desktop: titlul în stânga, formularul lat în dreapta, ca secțiunea să fie scundă */
  .nl__grid {
    display: grid; grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    gap: clamp(2rem, 5vw, 5rem); align-items: center;
    padding-block: clamp(3rem, 5vw, 4.2rem);
  }

  .nowrap { white-space: nowrap; }
  .nl__title { font-size: clamp(1.9rem, 1.35rem + 2.2vw, 3.1rem); margin-bottom: 0.45em; }
  .nl__title::after { content: ''; display: block; width: 72px; height: 5px; background: #fff; margin-top: 0.4em; }
  .nl__lead { font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem); line-height: 1.6; max-width: 34ch; opacity: 0.92; margin: 0; }

  .nl__form { display: grid; gap: 0.85rem; }
  .nl__row { display: grid; grid-template-columns: 1fr 1fr 1.4fr; gap: 0.85rem; }
  .nl__field { display: grid; gap: 0.35rem; }
  .nl__field label { font-size: 0.82rem; font-weight: 700; letter-spacing: 0.02em; }
  .nl__field input, .nl__field textarea {
    width: 100%; height: 50px; padding: 0 1rem;
    background: #fff; color: var(--text); border: 2px solid #fff; border-radius: var(--r-sm);
    font: inherit; font-size: 1rem; transition: border-color 0.2s, box-shadow 0.2s;
  }
  .nl__field textarea { height: auto; min-height: 96px; padding: 0.75rem 1rem; resize: vertical; }
  .nl__field :is(input, textarea):focus { outline: none; border-color: #000; box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.25); }
  .nl__field :is(input, textarea)[aria-invalid='true'] { border-color: #000; box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.55); }

  .nl__actions { display: flex; align-items: center; gap: 1.2rem; margin-top: 0.2rem; }
  .nl__submit {
    flex: none; display: inline-flex; align-items: center; gap: 0.6rem; height: 50px; padding: 0 1.6rem;
    background: #000; color: #fff; border: 0; border-radius: var(--r-sm); cursor: pointer;
    font-family: var(--display); font-weight: 700; font-size: 0.95rem; white-space: nowrap;
    transition: background-color 0.2s, transform 0.2s;
  }
  .nl__submit :global(svg) { width: 1.05em; height: 1.05em; transition: transform 0.3s var(--ease); }
  .nl__submit:hover { background: #1a1a1a; }
  .nl__submit:hover :global(svg) { transform: translateX(3px); }
  .nl__submit:active { transform: translateY(1px); }
  .nl__submit[disabled] { opacity: 0.7; cursor: progress; }

  .nl :global(.form-status) { color: #fff; font-weight: 700; margin: 0; min-height: 0; }
  .nl :global(.form-status:empty) { display: none; }
  .nl :global(.form-status.is-ok) { padding: 0.9rem 1rem; background: rgba(0, 0, 0, 0.25); border-left: 4px solid #fff; }
  .nl :global(.form-status.is-error) { color: #fff; padding: 0.7rem 1rem; background: rgba(0, 0, 0, 0.35); }
  .nl__note { font-size: 0.82rem; line-height: 1.45; margin: 0; max-width: 48ch; opacity: 0.88; }
  .nl__note a { color: inherit; text-decoration: underline; }

  @media (max-width: 960px) {
    .nl__grid { grid-template-columns: 1fr; gap: 1.6rem; }
    .nl__lead { max-width: 48ch; }
  }
  @media (max-width: 760px) {
    .nl__grid { padding-block: 2.6rem; gap: 1.3rem; }
    .nl__title { font-size: clamp(1.75rem, 7.4vw, 2.2rem); }
    .nl__lead { font-size: 1rem; }
    .nl__row { grid-template-columns: 1fr 1fr; }
    .nl__field--email { grid-column: 1 / -1; }
    .nl__actions { flex-direction: column; align-items: stretch; gap: 0.8rem; }
    .nl__submit { justify-content: center; width: 100%; }
  }
</style>
